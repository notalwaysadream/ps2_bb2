# Gnani API Credentials
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_WS_URL=wss://api.gnani.ai/v1/stt/stream  # Prisma v3.0
GNANI_TTS_WS_URL=wss://api.gnani.ai/v1/tts/stream  # Timbre v3.0

# LLM Configuration
LLM_PROVIDER=groq # or gemini
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Server Settings
HOST=0.0.0.0
PORT=8000
